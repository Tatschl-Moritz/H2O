FROM node:20-alpine

# tzdata: node-cron braucht die IANA-Zeitzonendatenbank fuer DST-korrektes
# Scheduling in Europe/Vienna (siehe worker/server.js). Kein crond/procps
# mehr noetig - Scheduling laeuft in-process ueber node-cron.
RUN apk add --no-cache tzdata
ENV TZ=Europe/Vienna

WORKDIR /app
COPY package*.json ./
RUN npm ci

COPY . .
RUN chmod +x worker/entrypoint.sh worker/init-volume.sh

VOLUME /shared

# Nur intern erreichbar (kein "ports:" in docker-compose.yml) - nginx im
# web-Container proxied /api/ hierher, siehe nginx.conf.template.
EXPOSE 3000

ENTRYPOINT ["/app/worker/entrypoint.sh"]
