FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:alpine AS runtime
COPY --from=build /app/dist /usr/share/nginx/html
# .template statt direkt nach conf.d/: das offizielle nginx-Image ersetzt
# beim Containerstart automatisch alle ${VAR}, die als echte Env-Var gesetzt
# sind (hier: INTERNAL_API_SECRET) - nginx-eigene Variablen wie $host bleiben
# unangetastet, da sie keine OS-Env-Vars sind. Siehe nginx.conf.template.
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
# Gemeinsames Volume mit dem Worker (befuellt /shared/data, /shared/history) -
# siehe nginx.conf.template fuer die /data/, /history/ und /api/ Locations.
VOLUME /shared
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
